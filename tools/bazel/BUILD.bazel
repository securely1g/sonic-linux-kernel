load("@rules_python//python:defs.bzl", "py_test")
load("@sonic_build_infra//tools/build_tools:defs.bzl", "python_runtime")

load(":kernel.bzl", "kernel_config")

package(default_visibility = ["//visibility:public"])

exports_files([
    "kernel_action.py",
    "kernel_arch.py",
    "stage_kernel.py",
])

kernel_config(
    name = "kernel_config",
    build_setting_default = "{}",
)

python_runtime(name = "python_runtime")

py_test(
    name = "kernel_action_test",
    srcs = [
        "build.py",
        "deb_test_support.py",
        "kernel_action.py",
        "kernel_action_test.py",
        "kernel_arch.py",
        "verify_install.py",
    ],
    main = "kernel_action_test.py",
)

py_test(
    name = "verify_cache_test",
    srcs = [
        "build.py",
        "deb_test_support.py",
        "kernel_action.py",
        "kernel_arch.py",
        "verify_cache.py",
        "verify_cache_test.py",
    ],
    main = "verify_cache_test.py",
)

py_test(
    name = "build_test",
    srcs = [
        "build.py",
        "build_test.py",
    ],
    data = [
        ":kernel.bzl",
        "//:MODULE.bazel",
        "//tools/bazel/cache-consumer:MODULE.bazel",
    ],
    main = "build_test.py",
)

py_test(
    name = "collect_ci_artifacts_test",
    srcs = [
        "collect_ci_artifacts.py",
        "collect_ci_artifacts_test.py",
        "kernel_action.py",
        "kernel_arch.py",
    ],
    main = "collect_ci_artifacts_test.py",
)

py_test(
    name = "stage_kernel_test",
    srcs = [
        "kernel_arch.py",
        "stage_kernel.py",
        "stage_kernel_test.py",
        "verify_debug.py",
    ],
    main = "stage_kernel_test.py",
)
