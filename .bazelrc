common --enable_bzlmod
common --lockfile_mode=update
# Immutable snapshot for standalone developer builds. Source CI uses the
# maintained draft branch selected by tools/bazel/cache-consumer/.bazelrc.
common --registry=https://raw.githubusercontent.com/securely1g/sonic-bazel-registry/bcf66bcb131f9a94b3e560668629f517db3ad857
common --registry=https://bcr.bazel.build
common --host_platform=@sonic_build_infra//platforms:x86_64_trixie
common --platforms=@sonic_build_infra//platforms:x86_64_trixie
build --sandbox_default_allow_network=false
build --remote_download_outputs=all
test --test_output=errors
