package(default_visibility = ["//visibility:public"])
filegroup(name = "source_files", srcs = glob(["**"], exclude = ["BUILD.bazel"], allow_empty = False))
exports_files(["Makefile"])

exports_files(glob(["**"], exclude = ["BUILD.bazel"]))
filegroup(name = "metadata_sources", srcs = glob([
    "debian/bin/gencontrol.py", "debian/lib/python/**", "debian/config/**", "debian/templates/**",
    "debian/changelog", "debian/copyright", "debian/README.Debian",
]))
